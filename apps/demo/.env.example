# ─── Database ───────────────────────────────────────────────────────────
# PostgreSQL connection string (Prisma mode).
# Optional — the app falls back to in-memory storage when unset.
# On Railway: injected automatically when you add a PostgreSQL service.
DATABASE_URL="postgresql://user:password@localhost:5432/siteping"

# ─── API Security ───────────────────────────────────────────────────────
# Protects admin operations (GET, PATCH, DELETE) on the feedback API.
# REQUIRED for production. Without this, anyone who knows the endpoint can
# read, create, and delete feedbacks.
SITEPING_API_KEY="change-me-to-a-random-secret"

# ─── Webhook Notifications (optional) ──────────────────────────────────
# # Slack / Discord incoming webhook URLs — fires on each new feedback.
# SITEPING_SLACK_WEBHOOK="https://hooks.slack.com/services/..."
# SITEPING_DISCORD_WEBHOOK="https://discord.com/api/webhooks/..."

# ─── Railway (set automatically — do not override) ─────────────────────
# PORT=3000
# NODE_ENV=production
